{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}


<style type="text/css">
  .gallery-carousel{
    .owl-item{
      display: flex;
      justify-content: center;
    }
  }
  .no-carousel {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}
.no-carousel .item {
  flex: 1 1 calc(25% - 10px);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}
@media (max-width: 599px) {
  .no-carousel .item {
    flex: 1 1 100%;
  }
}
</style>

{{ attach_library('gavias_linoor/photoswipe') }}

{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    'pool-contents'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
   <div class="left-section">
     <div class="left-a">
          <div class="title">
        <h1>{{label}}</h1>
       </div>
       <div class="brand">
           <h3> 
            <span>{{"Brand:"}} </span>{{content.field_brand}}
           </h3>
           <h4><span>{{"Category:"}}</span>{{content.field_category}}</h4>
       </div>
      
     </div>
    <div class="pswp-gallery">
<div class="gallery-wrapper gallery-wrapper--later owl-carousel gallery-carousel pswp-gallery--single-column container container-bg">
      {% for key, item in node.field_gallery_image %}
        {% set image_url = file_url(item.entity.uri.value) %}
        {% set full_url = file_url(item.entity.uri.value) %}
        {% set width = 2500 %}
        {% set height = 1668 %}

      
            <a href="{{ full_url }}" data-pswp-width="{{ width }}" data-pswp-height="{{ height }}" class="gallery-image">
              <img src="{{ image_url }}" alt="{{ item.alt }}" style="height: 150px; width: 150px;">
            </a>
    
      {% endfor %}
    </div>
    </div>
   </div>
   <div class="right-section container container-bg">
    <div class="part-a">
      <h1>{{"Specification"|upper}}</h1>
       <div class="properties">
        {{content.field_properties}}
       </div>
    </div>
    <div class="part-b">
      <h1>{{"pool features"|upper}}</h1>
      {{content.body}}
    </div>
 
   </div>
    {% endblock %}
  </div>
{% endblock paragraph %}




<script>
(function ($) {
  const $carousel = $('.gallery-carousel');
  const itemCount = $carousel.children().length;
  // Breakpoints
  const isMobile = window.matchMedia("(max-width: 599px)").matches;
  const isTabletOrDesktop = window.matchMedia("(min-width: 600px)").matches;

  console.log(isMobile)
  console.log(isTabletOrDesktop)
  // Decide when to enable carousel
  const shouldInitCarousel = isMobile || (isTabletOrDesktop && itemCount > 4);

  if (shouldInitCarousel) {
    $carousel.owlCarousel({
      loop: true,
      margin: 10,
      nav: true,
      dots: true,
      autoplay: true,
      autoplayTimeout: 10000,
      smartSpeed: 1500,
      responsive: {
        0: { items: 3 },
        600: { items: 4 },
        1000: { items: 6 }
      }
    });
  } else {
    // If not enough items → show static layout
    $carousel.addClass('no-carousel');
  }
})(jQuery);
</script>

  